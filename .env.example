PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Adres tej samej usługi, bez ukośnika na końcu:
PUBLIC_URL=https://roulette-choy.onrender.com
# Render External Database URL: true. Lokalny PostgreSQL / Docker: false.
DB_SSL=true
# Weryfikacja certyfikatu jest domyślnie włączona.
DB_SSL_REJECT_UNAUTHORIZED=true
# Liczba zaufanych reverse proxy; dla Render zwykle 1, lokalnie 0.
TRUST_PROXY_HOPS=1
